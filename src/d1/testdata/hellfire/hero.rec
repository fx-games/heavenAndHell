potion_mana: 1
spell_life: 2
mana_cost: 1
magic_to_hit: 50
melee_to_hit: 70
ranged_to_hit: 60
attack_frames: default=16 axe=20
spell_frames: 20
hit_frames: 6
flags: critical_strike
key: warrior
