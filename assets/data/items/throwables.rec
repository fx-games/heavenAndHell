%rec: default
#FIELDS: name internal_name icon dlvl cost charges max_level out_of_depth_chance min_level_for_ood category armor_type armor_class weapon_type weapon_damage weapon_speed throw_hit_zone throw_damage throw_chance_to_break throw_on_hit_effect light_color light_flicker_pattern light_flicker_frame_delay equip_modifier untargeted_action targeted_action

#throw_hit_zone: target_only |  dijkstra_aoe
#throw_on_hit_effect: confuse

#throw_hit_zone, throw_damage, throw_chance_to_break, throw_on_hit_effect
name: a dart
internal_name: dart
category: throwable
throw_hit_zone: target_only
throw_damage: 1-4
throw_chance_to_break: 0.2
icon: 232
dlvl: 1

name: a dart of confusion
internal_name: dart_confusion
category: throwable
throw_hit_zone: target_only
throw_damage: 1-4
throw_chance_to_break: 0.2
throw_on_hit_effect: apply(confused, 4)
icon: 232
dlvl: 1

# a more complicated example..tooltip should be auto-generated from this information, too
name: a flask of oil
internal_name: flask_of_oil
category: potion
throw_hit_zone: dijkstra_aoe(1)
throw_damage: 1-4
throw_chance_to_break: 1.0
throw_on_hit_effect: fire_zone
rule: throw_effect_needs_light_source
icon: 246
dlvl: 1
