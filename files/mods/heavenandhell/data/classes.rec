%rec: default
# classes.rec: the classes a new hero can pick, one record each, in the order the class menu lists them. Record N is
# the same class as hero.rec's class record N, which holds its numbers and rules.
# Fields:
#   internal_name     the class's id; its sprites are icons/actors.rec's class.<internal_name>_male / _female
#   name              what the class menu shows
#   gold              gold a new hero starts with
#   item              an item a new hero starts with, by items.rec internal_name; repeatable. Weapons and armour
#                     are equipped; "<item> pack" puts it in the pack instead of a hand
#   targeted_skill    a targeted skill (effects/targeted.rec) the class knows; repeatable
#   untargeted_skill  an untargeted skill (effects/untargeted.rec) the class knows; repeatable
#   stats_<stat>      read but not used: the hero's attributes come from hero.rec
#   resource_<name>   read but not used: life and mana come from hero.rec
#
# The three classes this game is played with. Classes are content: the engine keeps no roster of them and reads
# each class' two sprites from this mod's actors.rec by internal_name (class.<internal_name>_male/_female).
#
# The hero model itself is the engine's one unified hero, so each class names the hero archetype it plays as
# (warrior / rogue / sorcerer) and carries its OWN display name over it. The Archer plays as the rogue and the
# Mage as the sorcerer, which is what they always were.

internal_name: warrior
name: Warrior
gold: 180
item: main_gauche
item: torch
item: partial_leather_armour
resource_health: 20
resource_mana: 1
stats_strength: 15
stats_dexterity: 5
stats_intelligence: 5
targeted_skill: poison_target
targeted_skill: earth_shaker

internal_name: rogue
name: Archer
gold: 180
item: short_bow
item: torch
item: partial_leather_armour
resource_health: 15
resource_mana: 1
stats_strength: 8
stats_dexterity: 15
stats_intelligence: 5
untargeted_skill: multi_shot
targeted_skill: blink
targeted_skill: jump_start(5 | 5)

internal_name: sorcerer
name: Mage
gold: 180
item: dagger
item: torch
item: robe
resource_health: 10
resource_mana: 4
stats_strength: 5
stats_dexterity: 5
stats_intelligence: 15
untargeted_skill: heal_health
targeted_skill: fire_ray
