%rec: default
# mod.rec: rules and settings this mod fixes; they win over config.rec and the player cannot change them. One
# record only (a blank line would start a second one, which is not read). Fields, all optional:
#   AutosaveOnLevelChange   true / false: whether the game saves on every level change
#   Lighting                aura: a light around the hero always, radius 10 plus the gear's light affixes (Diablo);
#                           carried: only the equipped light source lights the dark while it burns (Angband).
#                           Default aura
#   LightInTown             carried only, true / false: whether the light source glows in town too. Default true
#   LightBurnsInTown        carried only, true / false: whether it uses up charges there. Default false
#   Respawn                 disabled: dead is dead (default); enabled: every monster is back each time a dungeon
#                           level is entered; timed: RespawnCount of them per RespawnTurns turns away; town_visits:
#                           RespawnCount of them per town visit since the level was left
#   RespawnCount, RespawnTurns  numbers for timed / town_visits
#   RespawnUniques          none: respawns are ordinary monsters (default); random: a unique of the depth may be
#                           rolled too; same: the level's own dead uniques come back. Respawns are always rolled
#                           afresh from the monster table, never copies of the dead
#   PersistLevels           true / false: false forgets a dungeon level when it is left and builds a new one on the
#                           next visit (Angband). Default true
#   PersistQuestLevels      true / false: true keeps a quest's level (and a set piece) as it is, never rebuilt nor
#                           respawned; false lets the rules above apply to it too. Default true
#   AuraLightColor          "R G B" of the hero's own light (aura), of wall torches and braziers, and of a light
#                           source that names no light_color. Default 255 255 255
#   AuraLightFlicker        its flicker: fire, smooth, steady or numbers, as items.rec's light_flicker_pattern.
#                           Default steady. AuraLightFlickerDelay: seconds per frame, default 1
#   DamageNotation          dice: damage shows as NdS+B (2d6+1); interval: as min-max (3-13). Default interval
#   Font                    the UI font, a file in the mod's fonts/ folder. Required. Only a default: the player
#                           picks another in the menus
#   TitleImage              optional: a file directly under the mod's folder, shown as a splash screen on startup
# A light source's color, flicker and radius are its own: items.rec's light_color, light_flicker_pattern
# (fire, smooth, steady or numbers), light_flicker_frame_delay and equip_modifier light_radius(n).
#

# Lighting: carried is Angband's: in the dark the hero sees only by the light source they carry, as far as it
# (and any other light_radius gear) reaches, and only while it has charges left to burn.
Lighting: carried
# The torch lights the town's streets too, but burns no fuel there.
LightInTown: true
LightBurnsInTown: false
Font: Ac437_EagleSpCGA_Alt3.ttf
TitleImage: heaven_and_hell_title.png
# The hero's torch-like light: warm, flickering like fire.
AuraLightColor: 255 223 117
AuraLightFlicker: fire
AuraLightFlickerDelay: 0.125
DamageNotation: dice
