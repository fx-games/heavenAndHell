%rec: default
# effects/targeted.rec: the targeted skills and item actions (aimed at a cell), one record each; classes.rec,
# enemies.rec and items.rec name them by internal_name. What an effect does is the engine's; this names and
# aims it.
# Fields:
#   internal_name     the skill's id; required
#   name              its shown name
#   icon              its tile number on the sprite sheet
#   dlvl              the dungeon level it belongs to (item level of the wands and scrolls that carry it)
#   targeting         how the target is picked: direct, melee, ranged, jumpstart, earthshaker
#   hit_zone          the cells it reaches, as in items.rec's throw_hit_zone (target_only, dijkstra_aoe(3), ...)
#   effect            what it does there: an engine effect with arguments split by |, e.g. fireball(8),
#                     spell_damage(...), confuse, poison, steal_item, mind_push, summon_monster(rat)
#

name: Steal Item
internal_name: steal_item
icon: 223
dlvl: 1
targeting: melee
hit_zone: target_only
effect: steal_item

name: Mind Push
internal_name: mind_push
icon: 223
dlvl: 1
targeting: direct
hit_zone: target_only
effect: mind_push

name: Fireball
internal_name: fireball
icon: 223
dlvl: 1
targeting: ranged
hit_zone: dijkstra_aoe(3)
effect: fireball

name: Fire Ray
internal_name: fire_ray
icon: 223
dlvl: 1
targeting: ranged
hit_zone: ray_aoe(7)
effect: project_fire

name: Fire Bresen
internal_name: fire_bresen
icon: 223
dlvl: 1
targeting: ranged
hit_zone: bresenham_aoe(7)
effect: project_fire

name: Fire Wall
internal_name: fire_wall
icon: 223
dlvl: 1
targeting: direct
hit_zone: wall_aoe(5)
effect: project_fire

name: Steal Item and Teleport
internal_name: steal_item_vanish
icon: 223
dlvl: 1
targeting: melee
hit_zone: target_only
effect: steal_item_teleport

name: Blink
internal_name: blink
icon: 223
dlvl: 1
targeting: direct
hit_zone: target_only
effect: blink

name: Confuse
internal_name: confuse_target
icon: 223
dlvl: 1
targeting: direct
hit_zone: target_only
effect: confuse

name: Poison
internal_name: poison_target
icon: 223
dlvl: 1
targeting: direct
hit_zone: target_only
effect: poison

name: Immobilize
internal_name: immobilize_target
icon: 223
dlvl: 1
targeting: direct
hit_zone: target_only
effect: immobilize

name: Jump Start
internal_name: jump_start
icon: 223
dlvl: 1
targeting: jumpstart(5 | 5)
hit_zone: target_only
effect: jumpstart

name: Earth Shaker
internal_name: earth_shaker
icon: 223
dlvl: 1
targeting: earthshaker(5 | 5)
hit_zone: neighbors_only(1)
effect: earthshaker

name: Summon Monster
internal_name: summon_monster
icon: 223
dlvl: 1
targeting: direct
hit_zone: target_only
effect: summon_monster