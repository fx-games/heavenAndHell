# quests.rec: the quests and the triggers that move them. Quests are found by key, in any order; the quest log
# lists them in file order.
# %rec: quest, one record per quest:
#   key               the quest's id, used by triggers and saves; required
#   name              its name in the quest log
#   level             levels.rec map id of the level it belongs to (its boss, its set piece, its entrance)
#   log_text          texts.rec id shown in the quest log
#   new_game_plus     true: finishing it turns the game into new game plus
#   gossip            "<npc> <text id>": what that townsperson says about it while it is active; repeatable
# %rec: trigger, one record per trigger. Their order in the file never matters: an event runs in rounds, each
# checking every trigger not fired yet against the same state and running all that hold; the next round sees
# what they did. A conversation (on_talk, on_approach, on_talker_*) says one thing, so its conditions must rule
# each other out (TestTalkTriggersAreExclusive checks); it ends with the round its line fired in.
#   event             on_kill, on_item_pickup, on_item_use, on_enter_level, on_level_cleared, on_talk, on_approach
#   subject           what the event is about: a monster's internal or unique name (on_kill), an item's internal
#                     name (on_item_pickup, on_item_use), a level id (on_enter_level, on_level_cleared), an NPC's
#                     internal name (on_talk: its dialogue; on_approach: walking up to it)
#   when              a condition; empty: always. Functions: done(q) active(q) avail(q) logged(q) flag(name)
#                     v1(q) v2(q) (the quest's two variables) has(item); numbers: depth, deepest; map (the level id); and or not == < >=
#   do                an outcome, repeatable, in order: complete_quest(q) activate_quest(q) start_quest(q)
#                     start_town_quest(q) log_quest(q) set_quest_var(q, n, value) or_quest_var(q, n, bits)
#                     set_flag(name) say(text [, speaker]) sound(id) hero_sound(n) end_text(text) give_exp(n)
#                     give_weapon(dlvl) take_item(item) drop_item(item) drop_unique(id) place_item(item, location
#                     or anywhere) spawn_item(item, map, location | here) spawn_monster(monster, location or
#                     anywhere) add_npc(npc, map, location) remove_npc(npc, map) refresh_level()
#   pass              true: in a conversation, not its line: it may hold alongside the line (a hand-in, a log
#                     entry), and the conversation goes on to the next round after it
#
# Heaven & Hell's quests and the town's dialogue, ported from main's getTextFor* chains in common/def_dialogue.go.
#
# Main showed each NPC the furthest step of a fixed chain whose flag was set. Here each step is an on_talk trigger
# whose condition names its step exactly, so at most one holds at a time.
#
# The texts live in text/town.txt. What main rewarded (a random weapon of some depth and 1000 experience) is
# give_weapon and give_exp.

%rec: quest

key: meat_jack
name: Kill Meat Jack
log_text: TEXT_HH_KIRIOTH_WELCOME

key: poisoned_water
name: Clean the poisoned water
log_text: TEXT_HH_ABEL_POISON_QUEST

key: skeleton_king
name: Kill King Zedek
log_text: TEXT_HH_SHEKEL_SKELETON_KING_QUEST

key: lost_pilgrims
name: The lost pilgrims
level: caves_10
log_text: TEXT_HH_MARY_PILGRIMS_QUEST

key: lucifer
name: Kill Lucifer
log_text: TEXT_HH_KIRIOTH_LUCIFER_QUEST

key: evidence
name: Find evidence against humanity
log_text: TEXT_HH_NOTE_LUCIFER

# The second act, given by Lucifer in the town in hell once the evidence is found (plan.txt's "Quests #2").

key: adventurers
name: Kill the butchering adventurers
level: doom_9
log_text: TEXT_HH_LUCIFER_ACT2_OFFER

key: skeleton_army
name: Bring peace to the skeleton army
level: catacombs_8
log_text: TEXT_HH_ZEDEK_CROWN

key: shekel
name: Kill Shekel
level: merchant_12
log_text: TEXT_HH_LUCIFER_ACT2_OFFER

key: kirioth
name: Kill Kirioth
level: town
new_game_plus: true
log_text: TEXT_HH_LUCIFER_KIRIOTH_OFFER

%rec: trigger

# What the dungeon tells the town.

event: on_kill
subject: meat_jack
do: set_flag(killed:meat_jack)

event: on_kill
subject: king_zedek
do: set_flag(killed:king_zedek)

event: on_kill
subject: lucifer
do: set_flag(killed:lucifer)
do: say(TEXT_HH_LUCIFER_DEATH, Lucifer)
do: spawn_item(lucifers_gift, town, true_sight_potion)

event: on_level_cleared
subject: poisoned_water_supply
do: set_flag(cleared:poisoned_water_supply)

# The evidence, where main's notes say it lies: at the poisoned water supply, at King Zedek's tomb, in Shekel's
# house, and in the caves. Each stays hidden until the hero drinks Lucifer's gift, which opens the quest.

event: on_level_cleared
subject: poisoned_water_supply
do: spawn_item(evidence_one, here)

event: on_kill
subject: king_zedek
do: spawn_item(evidence_two, here)

event: on_item_use
subject: lucifers_gift
do: say(TEXT_HH_NOTE_LUCIFER, A note)
do: spawn_item(lucifers_note, here)
do: activate_quest(evidence)
do: log_quest(evidence)
do: spawn_item(evidence_three, town, shekels_house)

event: on_enter_level
subject: caves_12
when: active("evidence") and not flag("placed:evidence_four")
do: set_flag(placed:evidence_four)
do: spawn_item(evidence_four, here)

event: on_item_pickup
subject: evidence_one
do: set_flag(found:evidence_one)

event: on_item_pickup
subject: evidence_two
do: set_flag(found:evidence_two)

event: on_item_pickup
subject: evidence_three
do: set_flag(found:evidence_three)

event: on_item_pickup
subject: evidence_four
do: set_flag(found:evidence_four)

event: on_item_pickup
subject: evidence_one
when: active("evidence") and flag("found:evidence_one") and flag("found:evidence_two") and flag("found:evidence_three") and flag("found:evidence_four")
do: complete_quest(evidence)
do: say(TEXT_HH_LUCIFER_RANT, Lucifer)
do: give_exp(1000)

event: on_item_pickup
subject: evidence_two
when: active("evidence") and flag("found:evidence_one") and flag("found:evidence_two") and flag("found:evidence_three") and flag("found:evidence_four")
do: complete_quest(evidence)
do: say(TEXT_HH_LUCIFER_RANT, Lucifer)
do: give_exp(1000)

event: on_item_pickup
subject: evidence_three
when: active("evidence") and flag("found:evidence_one") and flag("found:evidence_two") and flag("found:evidence_three") and flag("found:evidence_four")
do: complete_quest(evidence)
do: say(TEXT_HH_LUCIFER_RANT, Lucifer)
do: give_exp(1000)

event: on_item_pickup
subject: evidence_four
when: active("evidence") and flag("found:evidence_one") and flag("found:evidence_two") and flag("found:evidence_three") and flag("found:evidence_four")
do: complete_quest(evidence)
do: say(TEXT_HH_LUCIFER_RANT, Lucifer)
do: give_exp(1000)

# Elder Kirioth: Meat Jack, then, once King Zedek is dead, Lucifer.

event: on_talk
subject: kirioth
when: active("lucifer") and flag("killed:lucifer")
do: say(TEXT_HH_KIRIOTH_LUCIFER_QUEST_REWARD)
do: complete_quest(lucifer)
do: give_weapon(10)
do: give_exp(1000)

event: on_talk
subject: kirioth
when: active("lucifer") and not flag("killed:lucifer")
do: say(TEXT_HH_KIRIOTH_LUCIFER_QUEST)

event: on_talk
subject: kirioth
when: done("meat_jack") and flag("killed:king_zedek") and not active("lucifer") and not done("lucifer")
do: say(TEXT_HH_KIRIOTH_LUCIFER_QUEST)
do: activate_quest(lucifer)
do: log_quest(lucifer)

event: on_talk
subject: kirioth
when: done("meat_jack") and not active("lucifer") and (done("lucifer") or not flag("killed:king_zedek"))
do: say(TEXT_HH_KIRIOTH_AFTER_MEAT_JACK)

event: on_talk
subject: kirioth
when: active("meat_jack") and flag("killed:meat_jack") and not active("lucifer")
do: say(TEXT_HH_KIRIOTH_MEAT_JACK_REWARD)
do: complete_quest(meat_jack)
do: give_weapon(4)
do: give_exp(1000)

event: on_talk
subject: kirioth
when: active("meat_jack") and not flag("killed:meat_jack") and not active("lucifer")
do: say(TEXT_HH_KIRIOTH_MEAT_JACK)

event: on_talk
subject: kirioth
when: not active("meat_jack") and not done("meat_jack") and not active("lucifer")
do: say(TEXT_HH_KIRIOTH_WELCOME)
do: activate_quest(meat_jack)
do: log_quest(meat_jack)

# Prince Abel: the poisoned water, once Meat Jack is dead.

event: on_talk
subject: abel
when: done("poisoned_water")
do: say(TEXT_HH_ABEL_AFTER_POISON_QUEST)

event: on_talk
subject: abel
when: active("poisoned_water") and flag("cleared:poisoned_water_supply")
do: say(TEXT_HH_ABEL_POISON_QUEST_REWARD)
do: complete_quest(poisoned_water)
do: give_weapon(6)
do: give_exp(1000)

event: on_talk
subject: abel
when: active("poisoned_water") and not flag("cleared:poisoned_water_supply")
do: say(TEXT_HH_ABEL_POISON_QUEST)

event: on_talk
subject: abel
when: flag("killed:meat_jack") and not active("poisoned_water") and not done("poisoned_water")
do: say(TEXT_HH_ABEL_POISON_QUEST)
do: activate_quest(poisoned_water)
do: log_quest(poisoned_water)

event: on_talk
subject: abel
when: not flag("killed:meat_jack") and not active("poisoned_water") and not done("poisoned_water")
do: say(TEXT_HH_ABEL_WELCOME)

# Shekel: King Zedek, once the water runs clean.

event: on_talk
subject: shekel
when: done("skeleton_king")
do: say(TEXT_HH_SHEKEL_AFTER_SKELETON_KING)

event: on_talk
subject: shekel
when: active("skeleton_king") and flag("killed:king_zedek")
do: say(TEXT_HH_SHEKEL_SKELETON_KING_QUEST_REWARD)
do: complete_quest(skeleton_king)
do: give_weapon(6)
do: give_exp(1000)

event: on_talk
subject: shekel
when: active("skeleton_king") and not flag("killed:king_zedek")
do: say(TEXT_HH_SHEKEL_SKELETON_KING_QUEST)

event: on_talk
subject: shekel
when: flag("cleared:poisoned_water_supply") and not active("skeleton_king") and not done("skeleton_king")
do: say(TEXT_HH_SHEKEL_SKELETON_KING_QUEST)
do: activate_quest(skeleton_king)
do: log_quest(skeleton_king)

event: on_talk
subject: shekel
when: not flag("cleared:poisoned_water_supply") and not active("skeleton_king") and not done("skeleton_king")
do: say(TEXT_HH_SHEKEL_WELCOME)

# Sister Mary: her lost pilgrims, once King Zedek is dead and the way to the caves is open. A fetch quest on
# caves 10; the rosary lies among the Forsaken, who are the pilgrims.

event: on_talk
subject: mary
when: not flag("killed:king_zedek") and not active("lost_pilgrims") and not done("lost_pilgrims")
do: say(TEXT_HH_MARY_WELCOME)

event: on_talk
subject: mary
when: flag("killed:king_zedek") and not active("lost_pilgrims") and not done("lost_pilgrims")
do: say(TEXT_HH_MARY_PILGRIMS_QUEST)
do: activate_quest(lost_pilgrims)
do: log_quest(lost_pilgrims)

event: on_talk
subject: mary
when: active("lost_pilgrims") and not has("pilgrim_rosary")
do: say(TEXT_HH_MARY_PILGRIMS_WAITING)

event: on_talk
subject: mary
when: active("lost_pilgrims") and has("pilgrim_rosary")
do: say(TEXT_HH_MARY_PILGRIMS_REWARD)
do: take_item(pilgrim_rosary)
do: complete_quest(lost_pilgrims)
do: give_weapon(10)
do: give_exp(1500)

event: on_talk
subject: mary
when: done("lost_pilgrims")
do: say(TEXT_HH_MARY_AFTER_PILGRIMS)

event: on_enter_level
subject: caves_10
when: active("lost_pilgrims") and not flag("placed:pilgrim_rosary")
do: set_flag(placed:pilgrim_rosary)
do: place_item(pilgrim_rosary, anywhere)
do: spawn_monster(rotting_pilgrim, anywhere)
do: spawn_monster(rotting_pilgrim, anywhere)
do: spawn_monster(black_death, anywhere)

# The second act. Its bosses turn up the first time the hero enters their level while the quest is active; the
# four adventurers each set one bit of the quest's v1, so all four dead is 15.

event: on_enter_level
subject: doom_9
when: active("adventurers") and not flag("placed:adventurers")
do: set_flag(placed:adventurers)
do: spawn_monster(adventurer_knight, anywhere)
do: spawn_monster(adventurer_priest, anywhere)
do: spawn_monster(adventurer_barbarian, anywhere)
do: spawn_monster(adventurer_archer, anywhere)

event: on_kill
subject: adventurer_knight
do: or_quest_var(adventurers, 1, 1)

event: on_kill
subject: adventurer_priest
do: or_quest_var(adventurers, 1, 2)

event: on_kill
subject: adventurer_barbarian
do: or_quest_var(adventurers, 1, 4)

event: on_kill
subject: adventurer_archer
do: or_quest_var(adventurers, 1, 8)

event: on_item_use
subject: zedeks_crown
when: map == "catacombs_8"
do: say(TEXT_HH_ZEDEK_CROWN_BURIED, King Zedek's crown)
do: take_item(zedeks_crown)
do: set_flag(buried:zedeks_crown)

event: on_enter_level
subject: merchant_12
when: active("shekel") and not flag("placed:evil_shekel")
do: set_flag(placed:evil_shekel)
do: spawn_monster(evil_shekel, anywhere)

event: on_kill
subject: evil_shekel
do: set_flag(killed:evil_shekel)
do: remove_npc(shekel, town)

event: on_enter_level
subject: town
when: active("kirioth") and not flag("placed:evil_kirioth")
do: set_flag(placed:evil_kirioth)
do: spawn_monster(evil_kirioth, spawn)

event: on_kill
subject: evil_kirioth
do: end_text(TEXT_HH_END)
do: say(TEXT_HH_KIRIOTH_DEATH, Kirioth)
do: complete_quest(kirioth)
do: give_exp(5000)
do: remove_npc(kirioth, town)
do: add_npc(lucifer_townsman, town, spawn)

# Lucifer, in the town in hell: latest step first. The hand-ins pass, so one talk can settle several debts.

event: on_talk
subject: lucifer_townsman
when: done("kirioth")
do: say(TEXT_HH_LUCIFER_ENDING)

event: on_talk
subject: lucifer_townsman
when: active("kirioth")
do: say(TEXT_HH_LUCIFER_KIRIOTH_WAITING)

event: on_talk
subject: lucifer_townsman
when: done("adventurers") and done("skeleton_army") and done("shekel") and not active("kirioth") and not done("kirioth")
do: say(TEXT_HH_LUCIFER_KIRIOTH_OFFER)
do: activate_quest(kirioth)
do: log_quest(kirioth)

event: on_talk
subject: lucifer_townsman
when: active("adventurers") and v1("adventurers") == 15
pass: true
do: say(TEXT_HH_LUCIFER_ADVENTURERS_DONE)
do: complete_quest(adventurers)
do: give_weapon(12)
do: give_exp(2000)

event: on_talk
subject: lucifer_townsman
when: active("skeleton_army") and flag("buried:zedeks_crown")
pass: true
do: say(TEXT_HH_LUCIFER_SKELETON_ARMY_DONE)
do: complete_quest(skeleton_army)
do: give_weapon(12)
do: give_exp(2000)

event: on_talk
subject: lucifer_townsman
when: active("shekel") and flag("killed:evil_shekel")
pass: true
do: say(TEXT_HH_LUCIFER_SHEKEL_DONE)
do: complete_quest(shekel)
do: give_weapon(13)
do: give_exp(2000)

event: on_talk
subject: lucifer_townsman
when: (active("adventurers") or active("skeleton_army") or active("shekel")) and not done("kirioth") and not active("kirioth")
do: say(TEXT_HH_LUCIFER_ACT2_WAITING)

event: on_talk
subject: lucifer_townsman
when: done("evidence") and not active("adventurers") and not done("adventurers") and not done("kirioth") and not active("kirioth") and not (active("adventurers") or active("skeleton_army") or active("shekel"))
do: say(TEXT_HH_LUCIFER_ACT2_OFFER)
do: activate_quest(adventurers)
do: activate_quest(skeleton_army)
do: activate_quest(shekel)
do: log_quest(adventurers)
do: log_quest(skeleton_army)
do: log_quest(shekel)
do: spawn_item(zedeks_crown, town, shekels_house)
