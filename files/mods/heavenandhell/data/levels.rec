width: 40
height: 40
min_leaf: 6
min_room: 2
grow: 4
hall_chance: 0.15
spine: true
arch_chance: 0.2
loop_chance: 0.6
loop_distance: 8
posts: 0.02
one_opening: true
door_chance: 0
room_doors: 12 1
canvas: 40
scale: 2
population: d1_cathedral
library_stands: 65
decoration: tile.grate 26 thin
decoration: tile.cathedral_wall_missiles_pass 21 corner
decoration: tile.cathedral_wall_see_through 1.3 face
tile: arch tile.arch
tile: column tile.cathedral_column
tile: pillar tile.pillar
tile: lamp tile.lamp
lamps: 5 9

