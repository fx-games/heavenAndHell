exit: ladder_up -> catacombs_3, ladder_down
exit: ladder_down -> caves_5, ladder_up
exit: to_town -> town, to_catacombs
templates: assets/maps.ldtk
template_prefix: Cata
require_room: Cata_template_for_king_zedek
forbid_room: Cath_template_for_meat_jack
