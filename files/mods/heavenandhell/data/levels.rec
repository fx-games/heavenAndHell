%rec: default
# Which generation strategy builds each dungeon level, with which parameters, and how it presents itself.
#
# The knobs that belong to the LEVEL rather than to any one generator:
#   name         what the level calls itself on arrival. \n breaks the line.
#   tiles        which of the engine's tile sets draws it: cathedral, catacombs, caves, hell.
#   transition   an extra way off this level, beyond the ladders up and down every level gets:
#                "<location name>, <target map>, <target location>, up|down".
#   up           where this level's OWN ladder up leads: "<target map>, <target location>". Every level's
#                leads to the one above it and the first level's to the town, but this game's town calls its
#                cathedral door to_cathedral, and the engine is not allowed to know that name.
#
# A record keyed by "map" instead of "dlvl" is a side level: reached only by a transition some other level
# declares, with a way up (its "up", required) and no way down. "depth" is the dungeon level whose monsters and
# loot it draws on.
#
# How deep this game goes is decided here and nowhere else: the deepest dlvl declared below is the bottom of
# the dungeon, and the engine gives that level no ladder down.
#
# generator   one of the engine's registered strategies. This mod's levels grow out of hand-drawn room
#             templates, so they all name "accretion"; "megadungeon" (carve a maze, knock holes in it) is
#             registered too and takes the knobs listed at the bottom of this file.
#
# The knobs accretion takes:
#   templates        the LDtk project the room templates live in. Defaults to assets/rooms.ldtk, which the mod
#                    overlay resolves to this mod's own rooms.ldtk.
#   template_prefix  only templates whose name starts with this are used - which is how a depth gets its look.
#   require_room     a template this level must contain (its quest room). Repeat the field for more.
#   forbid_room      a template this level must NOT contain, so another level's quest room cannot turn up here.
#   rooms            how many rooms to grow to (default 16).
#   min_rooms        regrow the level until it has at least this many (default 10).
#   width, height    the scratch grid the level grows into before it is trimmed (default 40x40).
#   doors            false leaves the room openings as corridors instead of placing doors.
#
# Every level forbids the other levels' quest rooms, and the Poisoned Water Supply's cave template, which is a
# side level off level 3 rather than a dungeon level.

dlvl: 1
generator: accretion
name: Level 1\nCathedral
tiles: cathedral
up: Town, to_cathedral
templates: assets/maps.ldtk
template_prefix: Cath
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 2
generator: accretion
name: Level 2\nCathedral
tiles: cathedral
templates: assets/maps.ldtk
template_prefix: Cath
require_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 3
generator: accretion
name: Level 3\nCatacombs
tiles: catacombs
templates: assets/maps.ldtk
transition: to_poisoned_water_supply, poisoned_water_supply, ladder_up, down
template_prefix: Cata
forbid_room: Cath_template_for_meat_jack
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 4
generator: accretion
name: Level 4\nCatacombs
tiles: catacombs
templates: assets/maps.ldtk
transition: to_town, Town, to_catacombs, up
template_prefix: Cata
require_room: Cata_template_for_king_zedek
forbid_room: Cath_template_for_meat_jack
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

# The caves and hell levels are open caverns: their room openings stay corridors, no doors.
dlvl: 5
generator: accretion
name: Level 5\nCaves
tiles: caves
templates: assets/maps.ldtk
template_prefix: Cave
doors: false
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 6
generator: accretion
name: Level 6\nCaves
tiles: caves
templates: assets/maps.ldtk
transition: to_town, Town, to_caves, up
template_prefix: Cave
doors: false
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 7
generator: accretion
name: Level 7\nHell
tiles: hell
templates: assets/maps.ldtk
template_prefix: Hell
doors: false
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 8
generator: accretion
name: Level 8\nHell
tiles: hell
templates: assets/maps.ldtk
template_prefix: Hell
doors: false
require_room: Hell_template_for_lucifer
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 9
generator: accretion
name: Level 9\nDungeon of Doom
tiles: caves
templates: assets/maps.ldtk
template_prefix: Dung
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Cave_template_for_poisoned_water

dlvl: 10
generator: accretion
name: Level 10\nDungeon of Doom
tiles: caves
templates: assets/maps.ldtk
template_prefix: Dung
require_room: Dung_template_for_rogue
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Cave_template_for_poisoned_water

dlvl: 11
generator: accretion
name: Level 11\nMerchant District
tiles: cathedral
templates: assets/maps.ldtk
template_prefix: Cath
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

dlvl: 12
generator: accretion
name: Level 12\nMerchant District
tiles: cathedral
templates: assets/maps.ldtk
template_prefix: Cath
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
forbid_room: Cave_template_for_poisoned_water

# Abel's quest: the source of the poison in the town's rivers, a cave off the catacombs.
map: poisoned_water_supply
depth: 3
up: !gen_dungeon_level_3, to_poisoned_water_supply
generator: accretion
name: Poisoned Water Supply
tiles: caves
templates: assets/maps.ldtk
template_prefix: Cave
doors: false
require_room: Cave_template_for_poisoned_water
forbid_room: Cath_template_for_meat_jack
forbid_room: Cata_template_for_king_zedek
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue

# megadungeon's knobs, for reference - it takes no templates at all:
#   width, height             the grid it carves (forced odd). Default 60x60.
#   room_tries                how many times it tries to drop a room in. Default 1266.
#   min_room_size             the smallest room edge. Default 5.
#   room_ratio                how far from square a room may be, 0 = square. Default 0.25.
#   straight_passage_chance   how strongly a corridor keeps its heading. Default 0.5.
#   imperfect_connect_chance  how often it adds a second way between two regions, making loops. Default 0.5.
#   door_distance             how far apart two doorways must be. Default 5.
#   dead_ends                 true keeps dead-end corridors. Default false: they are filled back in.
#   min_rooms                 regrow until the level has at least this many rooms. Default 10.
