# The town in hell, drawn in maps.ldtk: reached from level 8's caves and level 9's dungeon.
map: hell_town
name: The Town in Hell
depth: 8
generator: ldtk
template: TownHell
tiles: drawn
music: town
town: true
exit: to_caves -> hell_8, to_hell_town
exit: to_dungeon -> doom_9, to_hell_town

# Abel's quest: the source of the poison in the town's rivers, a cave off the catacombs.
map: poisoned_water_supply
name: Poisoned Water Supply
depth: 3
generator: accretion
tiles: caves
music: caves
exit: ladder_up -> catacombs_3, to_poisoned_water_supply
