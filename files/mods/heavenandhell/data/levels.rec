# The town in hell, drawn by hand: reached from Hell 16 and from the Dungeon of Doom, once Lucifer is dead
# (the Lucifer who lives there is the one who survived him).
map: hell_town
name: The Town in Hell
depth: 16
generator: drawn
template: TownHell
tiles: drawn
music: town
town: true
exit: to_caves -> hell_16, to_hell_town
exit: to_dungeon -> doom_9, to_hell_town

