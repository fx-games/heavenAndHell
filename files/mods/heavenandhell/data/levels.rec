tiles: catacombs
music: catacombs
exit: ladder_up -> cathedral_2, ladder_down
exit: ladder_down -> catacombs_4, ladder_up
exit: to_poisoned_water_supply -> poisoned_water_supply, ladder_up
templates: assets/maps.ldtk
template_prefix: Cata
forbid_room: Cath_template_for_meat_jack
forbid_room: Hell_template_for_lucifer
forbid_room: Dung_template_for_rogue
