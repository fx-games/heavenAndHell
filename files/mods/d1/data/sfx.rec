%rec: default
# Every speech and quest sound id D1 has (_sfx_id, effects.cpp's sgSFX), mapped to the file it was in Diablo
# (the .wav path lowercased, as .ogg). Generated from devilution 1.09's enums.h and effects.cpp. D1's own audio
# is not in this game: the ids are the records of assets/data/voices.rec, which is what the game plays, and the
# file names are only the key into reference/d1_voice_transcripts.tsv, the transcriptions of the cut lines.

id: IS_SARC
file: items/sarc.ogg

id: IS_QUESTDN
file: misc/questdon.ogg

