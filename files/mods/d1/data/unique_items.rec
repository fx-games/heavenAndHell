%rec: default
# unique_items.rec: Diablo's unique items (UniqueItemList), one record each. CheckUnique walks them
# in roll_order.rec's order; this file's own order doesn't matter.
# Fields:
#   internal_name     its id, what records refer to it by (enemies.rec drops, quests.rec drop_unique); required
#   name              shown name
#   base              the item it is built on, an items.rec unique_base (UITYPE_ name)
#   min_level         the lowest item level it drops on
#   value             its price
#   power             "<power> min max": one of its powers (as in xl_isuf.txt) with its value range; repeatable, up to 6

