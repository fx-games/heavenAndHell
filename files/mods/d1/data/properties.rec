key: mana_to_life
kind: text
format: half your mana becomes life
better: 0

key: life_to_mana
kind: text
format: two fifths of your life becomes mana
better: 0

key: return_damage
kind: signed
format: attacker takes %d%% of its melee blow back
better: 1

key: fireball_shot
kind: signed
format: shots burst in a fireball for %d damage
better: 1
