# --- triggers -------------------------------------------------------------------------------------------
#
# event    subject                    fired by
# on_kill          a monster's internal name, or a unique monster's name
# on_item_pickup   an item's internal name
# on_enter_level   the id of the level the hero arrives on (levels.rec's map)
# on_talk          the NPC's internal name -- a dialogue record: condition, text, what saying it does

%rec: trigger

event: on_kill
subject: MT_SKING
when: not done("leoric")
do: complete_quest(leoric)
do: hero_sound(82)

event: on_kill
subject: MT_CLEAVER
when: not done("butcher")
do: complete_quest(butcher)
do: hero_sound(80)

event: on_kill
subject: Gharbad the Weak
when: not done("garbud")
do: complete_quest(garbud)
do: hero_sound(61)

event: on_kill
subject: Zhar the Mad
when: not done("zhar")
do: complete_quest(zhar)
do: hero_sound(62)

event: on_kill
subject: Warlord of Blood
when: not done("warlord")
do: complete_quest(warlord)
do: hero_sound(94)

# Lazarus' death opens Diablo's level and the way back out of the lair.
event: on_kill
subject: Arch-Bishop Lazarus
when: not done("lazarus")
do: complete_quest(lazarus)
do: hero_sound(83)
do: set_quest_var(lazarus, 1, 7)
do: set_quest_var(lazarus, 2, 4)
do: activate_quest(diablo)
do: refresh_level()

event: on_kill
subject: MT_DIABLO
when: not done("diablo")
do: complete_quest(diablo)
do: sound(USFX_DIABLOD)
do: end_text(TEXT_D1_END)

# The dying townsman on level 2: his last words start the Butcher, and after that he only groans.
event: on_approach
subject: deadguy
when: active("butcher") and v1("butcher") != 0
do: hero_sound(8)

event: on_approach
subject: deadguy
when: (avail("butcher") and not done("butcher") and not active("butcher")) or (active("butcher") and v1("butcher") == 0)
do: activate_quest(butcher)
do: log_quest(butcher)
do: set_quest_var(butcher, 1, 1)
do: say(TEXT_BUTCH9)

event: on_item_pickup
subject: optic_amulet
do: complete_quest(blind)

event: on_item_pickup
subject: arkaine_s_valor
do: complete_quest(blood)
do: hero_sound(91)

event: on_item_pickup
subject: golden_elixir
do: hero_sound(88)

event: on_item_pickup
subject: black_mushroom
when: active("mushroom") and v1("mushroom") == 3
do: hero_sound(95)
do: set_quest_var(mushroom, 1, 4)

# Picking the anvil or the rock up starts its quest; the shout only comes once the hero knows what it is for.
event: on_item_pickup
subject: anvil_of_fury
when: avail("anvil") and not done("anvil") and not active("anvil")
do: activate_quest(anvil)
do: set_quest_var(anvil, 1, 1)

event: on_item_pickup
subject: anvil_of_fury
when: logged("anvil")
do: hero_sound(89)

event: on_item_pickup
subject: magic_rock
when: avail("rock") and not done("rock") and not active("rock")
do: activate_quest(rock)
do: set_quest_var(rock, 1, 1)

event: on_item_pickup
subject: magic_rock
when: logged("rock")
do: hero_sound(87)

# PlayDungMsgs: the hero's line on first reaching the cathedral, the catacombs, the caves and hell, and
# Diablo's greeting on 16. Each once, which is what the flag remembers.
event: on_enter_level
subject: cathedral_1
when: not flag("d1:dungmsg:1")
do: set_flag(d1:dungmsg:1)
do: hero_sound(97)

event: on_enter_level
subject: catacombs_5
when: not flag("d1:dungmsg:5")
do: set_flag(d1:dungmsg:5)
do: hero_sound(96)

event: on_enter_level
subject: caves_9
when: not flag("d1:dungmsg:9")
do: set_flag(d1:dungmsg:9)
do: hero_sound(98)

# ResyncQuests on arrival: the Fungal Tome lies on 9 until Adria has seen it.
event: on_enter_level
subject: caves_9
when: avail("mushroom") and not active("mushroom") and not done("mushroom") and v1("mushroom") == 0
do: set_quest_var(mushroom, 1, 1)
do: place_item(fungal_tome, anywhere)

# On 15: the red portal is seen open once Cain has the staff, and Lachdanan's Golden Elixir lies there.
event: on_enter_level
subject: hell_15
when: active("lazarus") and v1("lazarus") == 2
do: set_quest_var(lazarus, 1, 3)

event: on_enter_level
subject: hell_15
when: active("veil") and v1("veil") == 0
do: set_quest_var(veil, 1, 1)
do: place_item(golden_elixir, anywhere)

event: on_enter_level
subject: hell_13
when: not flag("d1:dungmsg:13")
do: set_flag(d1:dungmsg:13)
do: hero_sound(99)

event: on_enter_level
subject: hell_16
when: not flag("d1:dungmsg:16")
do: set_flag(d1:dungmsg:16)
do: sound(PS_DIABLVLINT)

# TalkToTowner's quest steps. Walking up to a townsperson plays their on_approach triggers in this order, and the
# first one that fires is the whole visit, as the function's return was; "pass" lets Pepin say two things.
# Quest steps (v1) for the mushroom: 2 tome given, 4 mushroom picked, 5 mushroom given, 7 brain given.

# Until the hero first leaves town (_pLvlVisited[0]; the first way out always leads to level 1) Ogden greets them.
event: on_approach
subject: ogden
when: not flag("d1:dungmsg:1") and not flag("d1:intro")
do: set_flag(d1:intro)
do: say(TEXT_INTRO)

event: on_approach
subject: ogden
when: deepest >= 2 and avail("leoric") and v2("leoric") == 0 and (flag("d1:dungmsg:1") or flag("d1:intro"))
do: set_quest_var(leoric, 2, 1)
do: start_town_quest(leoric)
do: say(TEXT_KING2)

event: on_approach
subject: ogden
when: deepest >= 2 and avail("leoric") and done("leoric") and v2("leoric") == 1 and (flag("d1:dungmsg:1") or flag("d1:intro"))
do: set_quest_var(leoric, 2, 2)
do: set_quest_var(leoric, 1, 2)
do: say(TEXT_KING4)

# 1.09 asks about Ogden's Sign only inside Leoric's check.
event: on_approach
subject: ogden
when: deepest >= 3 and avail("banner") and not done("banner") and v2("banner") == 0 and (flag("d1:dungmsg:1") or flag("d1:intro")) and not (deepest >= 2 and avail("leoric") and v2("leoric") == 0) and not (deepest >= 2 and avail("leoric") and done("leoric") and v2("leoric") == 1)
do: set_quest_var(banner, 2, 1)
do: start_town_quest(banner)
do: say(TEXT_BANNER2)

event: on_approach
subject: ogden
when: deepest >= 3 and avail("banner") and v2("banner") == 1 and has("tavern_sign") and (flag("d1:dungmsg:1") or flag("d1:intro")) and not (deepest >= 2 and avail("leoric") and v2("leoric") == 0) and not (deepest >= 2 and avail("leoric") and done("leoric") and v2("leoric") == 1)
do: take_item(tavern_sign)
do: complete_quest(banner)
do: set_quest_var(banner, 1, 3)
do: drop_unique(harlequin_crest)
do: say(TEXT_BANNER3)

event: on_approach
subject: griswold
when: deepest >= 4 and avail("rock") and v2("rock") == 0
do: set_quest_var(rock, 2, 1)
do: start_town_quest(rock)
do: say(TEXT_INFRA5)

event: on_approach
subject: griswold
when: deepest >= 4 and avail("rock") and v2("rock") == 1 and has("magic_rock")
do: take_item(magic_rock)
do: complete_quest(rock)
do: set_quest_var(rock, 2, 2)
do: set_quest_var(rock, 1, 2)
do: drop_unique(empyrean_band)
do: say(TEXT_INFRA7)

event: on_approach
subject: griswold
when: (deepest >= 9 and avail("anvil") and not done("anvil") and v2("anvil") == 0 and (v2("rock") == 2 or active("rock") and v2("rock") == 1)) and not (deepest >= 4 and avail("rock") and v2("rock") == 1 and has("magic_rock"))
do: set_quest_var(anvil, 2, 1)
do: start_town_quest(anvil)
do: say(TEXT_ANVIL5)

event: on_approach
subject: griswold
when: deepest >= 9 and avail("anvil") and v2("anvil") == 1 and has("anvil_of_fury") and not (deepest >= 4 and avail("rock") and v2("rock") == 0) and not (deepest >= 4 and avail("rock") and v2("rock") == 1 and has("magic_rock"))
do: take_item(anvil_of_fury)
do: complete_quest(anvil)
do: set_quest_var(anvil, 2, 2)
do: set_quest_var(anvil, 1, 2)
do: drop_unique(griswolds_edge)
do: say(TEXT_ANVIL7)

event: on_approach
subject: adria
when: avail("mushroom") and not active("mushroom") and not done("mushroom") and has("fungal_tome")
do: take_item(fungal_tome)
do: start_quest(mushroom)
do: set_quest_var(mushroom, 1, 2)
do: say(TEXT_MUSH8)

event: on_approach
subject: adria
when: active("mushroom") and v1("mushroom") >= 2 and v1("mushroom") <= 4 and has("black_mushroom")
do: take_item(black_mushroom)
do: set_quest_var(mushroom, 1, 5)
do: say(TEXT_MUSH10)

# said once: bit 1 of v2
event: on_approach
subject: adria
when: active("mushroom") and v1("mushroom") >= 2 and v1("mushroom") <= 4 and v2("mushroom") in [0, 2] and not has("black_mushroom")
do: or_quest_var(mushroom, 2, 1)
do: say(TEXT_MUSH9)

event: on_approach
subject: adria
when: active("mushroom") and (v1("mushroom") < 2 or v1("mushroom") > 4) and has("spectral_elixir")
do: complete_quest(mushroom)
do: say(TEXT_MUSH12)

# said once: bit 2 of v2
event: on_approach
subject: adria
when: active("mushroom") and (v1("mushroom") < 2 or v1("mushroom") > 4) and has("brain") and v2("mushroom") in [0, 1] and not has("spectral_elixir")
do: or_quest_var(mushroom, 2, 2)
do: say(TEXT_MUSH11)

event: on_approach
subject: pepin
when: deepest >= 1 and avail("pwater") and not active("pwater") and not done("pwater")
pass: true
do: start_quest(pwater)
do: set_quest_var(pwater, 1, 1)
do: say(TEXT_POISON3)

event: on_approach
subject: pepin
when: deepest >= 1 and done("pwater") and v1("pwater") != 2
pass: true
do: set_quest_var(pwater, 1, 2)
do: drop_unique(ring_of_truth)
do: say(TEXT_POISON5)

event: on_approach
subject: pepin
when: active("mushroom") and v1("mushroom") >= 5 and v1("mushroom") < 7 and has("brain")
do: take_item(brain)
do: drop_item(spectral_elixir)
do: set_quest_var(mushroom, 1, 7)
do: say(TEXT_MUSH4)

event: on_approach
subject: cain
when: avail("lazarus") and not active("lazarus") and not done("lazarus") and has("staff_of_lazarus")
do: take_item(staff_of_lazarus)
do: set_quest_var(lazarus, 1, 2)
do: start_quest(lazarus)
do: say(TEXT_VILE1)
do: refresh_level()

event: on_approach
subject: cain
when: done("lazarus") and v1("lazarus") == 7
do: set_quest_var(lazarus, 1, 8)
do: log_quest(diablo)
do: say(TEXT_VILE3)

# The quest bosses who speak before they fight (monsters.rec's talker AIs), ported from 1.09's talk state machines:
# InitMonsterTalk (on_talker_spawn), TalktoMonster (on_talker_talk), M_DoTalk (on_talker_said) and the MAI_*
# talk states that run every turn (on_talker_turn). The subject is the monster's AI. Like on_talk, it is one
# step: the conditions of one event rule each other out, except those that pass (they fire alongside).
# Conditions also see talk (what it has to say), goal (normal attack2 inquiring talking other) and visible
# (the hero sees it), plus at(location) and here(quest).

# Gharbad the Weak

event: on_talker_spawn
subject: AI_GARBUD
when: v1("garbud") == 0
do: talk(TEXT_GARBUD1)

event: on_talker_spawn
subject: AI_GARBUD
when: v1("garbud") == 1
do: talk(TEXT_GARBUD2)

event: on_talker_spawn
subject: AI_GARBUD
when: v1("garbud") == 2
do: talk(TEXT_GARBUD3)

event: on_talker_spawn
subject: AI_GARBUD
when: v1("garbud") == 3
do: talk(TEXT_GARBUD4)

event: on_talker_said
subject: AI_GARBUD
when: talk == "TEXT_GARBUD1"
do: activate_quest(garbud)
pass: true

event: on_talker_said
subject: AI_GARBUD
do: log_quest(garbud)
pass: true

event: on_talker_said
subject: AI_GARBUD
when: talk == "TEXT_GARBUD2" and v2("garbud") == 0
do: drop_monster_item()
do: set_quest_var(garbud, 2, 1)

event: on_talker_turn
subject: AI_GARBUD
when: v1("garbud") == 0 and not visible and goal == "talking"
do: set_quest_var(garbud, 1, 1)
do: talk(TEXT_GARBUD2)

event: on_talker_turn
subject: AI_GARBUD
when: v1("garbud") == 1 and not visible and goal == "talking"
do: set_quest_var(garbud, 1, 2)
do: talk(TEXT_GARBUD3)

event: on_talker_turn
subject: AI_GARBUD
when: v1("garbud") == 2 and not visible and goal == "talking"
do: set_quest_var(garbud, 1, 3)
do: talk(TEXT_GARBUD4)

event: on_talker_turn
subject: AI_GARBUD
when: visible and talk == "TEXT_GARBUD4" and goal == "talking"
do: set_quest_var(garbud, 1, 4)
do: quiet()

# Zhar the Mad (reading a bookcase once he knows you makes him say TEXT_ZHAR2 early)

event: on_talker_spawn
subject: AI_ZHAR
when: v1("zhar") == 0
do: talk(TEXT_ZHAR1)

event: on_talker_spawn
subject: AI_ZHAR
when: v1("zhar") == 1
do: talk(TEXT_ZHAR2)

event: on_talker_said
subject: AI_ZHAR
when: talk == "TEXT_ZHAR1" and v2("zhar") == 0
do: start_quest(zhar)
do: drop_misc_item(IMISC_BOOK)
do: set_quest_var(zhar, 2, 1)

event: on_talker_turn
subject: AI_ZHAR
when: talk == "TEXT_ZHAR1" and not visible and goal == "talking"
do: set_quest_var(zhar, 1, 1)
do: talk(TEXT_ZHAR2)

event: on_talker_turn
subject: AI_ZHAR
when: visible and talk == "TEXT_ZHAR2" and goal == "talking"
do: set_quest_var(zhar, 1, 2)
do: quiet()

event: on_talker_disturbed
subject: AI_ZHAR
when: here("zhar")
do: set_quest_var(zhar, 1, 1)
do: talk(TEXT_ZHAR2)
do: speak()

# Snotspill (the Tavern Sign)

event: on_talker_spawn
subject: AI_SNOTSPIL
when: v1("banner") < 2
do: talk(TEXT_BANNER10)

event: on_talker_spawn
subject: AI_SNOTSPIL
when: v1("banner") == 2
do: talk(TEXT_BANNER11)

event: on_talker_talk
subject: AI_SNOTSPIL
when: here("banner") and v1("banner") == 2 and has("tavern_sign")
do: take_item(tavern_sign)
do: complete_quest(banner)
do: talk(TEXT_BANNER12)

event: on_talker_said
subject: AI_SNOTSPIL
when: talk == "TEXT_BANNER10" and v1("banner") < 2
do: set_quest_var(banner, 1, 2)
do: activate_quest(banner)
do: refresh_level()

event: on_talker_turn
subject: AI_SNOTSPIL
when: talk == "TEXT_BANNER10" and not visible and goal == "talking"
do: talk(TEXT_BANNER11)

event: on_talker_turn
subject: AI_SNOTSPIL
when: talk == "TEXT_BANNER11" and v1("banner") == 3
do: stop_talking()

event: on_talker_turn
subject: AI_SNOTSPIL
when: visible and talk == "TEXT_BANNER12" and goal == "talking"
do: set_quest_var(banner, 1, 3)
do: refresh_level()
do: quiet()

# Lachdanan (the Golden Elixir)

event: on_talker_spawn
subject: AI_LACHDAN
when: logged("veil")
do: talk(TEXT_VEIL10)

event: on_talker_spawn
subject: AI_LACHDAN
when: not logged("veil")
do: talk(TEXT_VEIL9)

event: on_talker_talk
subject: AI_LACHDAN
when: here("veil") and talk startsWith "TEXT_VEIL" and has("golden_elixir")
do: take_item(golden_elixir)
do: talk(TEXT_VEIL11)

event: on_talker_said
subject: AI_LACHDAN
when: talk == "TEXT_VEIL9"
do: start_quest(veil)

event: on_talker_said
subject: AI_LACHDAN
when: talk == "TEXT_VEIL11" and v2("veil") == 0
do: drop_unique(veil_of_steel)
do: set_quest_var(veil, 2, 1)

event: on_talker_turn
subject: AI_LACHDAN
when: talk == "TEXT_VEIL9" and not visible and goal == "talking"
do: talk(TEXT_VEIL10)

event: on_talker_turn
subject: AI_LACHDAN
when: visible and talk == "TEXT_VEIL11" and goal == "talking"
do: silence()
do: complete_quest(veil)
do: kill_talker()

# Warlord of Blood

event: on_talker_spawn
subject: AI_WARLORD
when: v1("warlord") < 2
do: talk(TEXT_WARLRD9)

event: on_talker_said
subject: AI_WARLORD
do: set_quest_var(warlord, 1, 2)

event: on_talker_turn
subject: AI_WARLORD
when: visible and talk == "TEXT_WARLRD9" and goal == "inquiring"
do: speak()

event: on_talker_turn
subject: AI_WARLORD
when: visible and talk == "TEXT_WARLRD9" and goal == "talking"
do: quiet()

# Lazarus, who speaks once the hero stands on the circle in front of him, and his helpers

event: on_talker_spawn
subject: AI_LAZURUS
when: v1("lazarus") < 6
do: talk(TEXT_VILE13)

event: on_talker_spawn
subject: AI_LAZHELP
when: v1("lazarus") < 6
do: talk(TEXT_VILE13)

event: on_talker_turn
subject: AI_LAZURUS
when: visible and talk == "TEXT_VILE13" and goal == "inquiring" and at("vile_altar")
do: set_quest_var(lazarus, 1, 5)
do: speak()

event: on_talker_turn
subject: AI_LAZURUS
when: visible and talk == "TEXT_VILE13" and goal == "talking"
do: set_quest_var(lazarus, 1, 6)
do: refresh_level()
do: quiet()

event: on_talker_turn
subject: AI_LAZHELP
when: visible and v1("lazarus") <= 5
do: set_goal(inquiring)

event: on_talker_turn
subject: AI_LAZHELP
when: visible and v1("lazarus") > 5
do: stop_talking()
