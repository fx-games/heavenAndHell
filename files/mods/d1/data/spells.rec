%rec: default
# Per-spell data the xl_spell table has no columns for, keyed by the spell's SPL_ id.
# resist is the resistance its damaging missile is checked against (none/fire/lightning/magic; absent means
# the spell deals no resistible damage). targeted marks the spells that need a target cell (sTargeted, plus
# the ones D1 aims at the cursor anyway). The three sounds are the cast (spelldat's sSFX), the launch of its
# missile (misdat's mlSFX) and the impact where its bolt stops (miSFX); blank is silent.

id: SPL_FIREBOLT
resist: fire
targeted: true
cast_sfx: IS_CAST2
launch_sfx: LS_FBOLT1
impact_sfx: LS_FIRIMP2

id: SPL_HEAL
cast_sfx: IS_CAST8

