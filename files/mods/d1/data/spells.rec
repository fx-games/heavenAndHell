%rec: slot
# D1's spelldata names and a short tooltip sentence each, one record per spell slot in slot
# order starting at 0. The xl_spell table only carries some of the names, and the slots D1
# never uses still have to hold their place, so this is a plain list rather than keyed by id.

name:
description:

name: Firebolt
description: Hurls a bolt of fire at the target.

name: Healing
description: Restores some of your life.

name: Lightning
description: Fires a crackling line of lightning at the target.

name: Flash
description: Unleashes a burst of light that damages everything within 1 square of you.

name: Identify
description: Reveals the magical properties of an item.

name: Fire Wall
description: Raises a wall of flame that burns anything passing through.

name: Town Portal
description: Opens a portal back to town and returns you to where you were.

name: Stone Curse
description: Turns a monster to stone for a short while.

name: Vision
description: Shows every living thing on the level and lets you see them through walls.

name: Phasing
description: Teleports you to a random nearby spot.

name: Mana Shield
description: Uses your mana to absorb damage instead of life.

name: Fireball
description: Launches an exploding ball of fire at the target.

name: Guardian
description: Summons a fire-breathing guardian that attacks nearby monsters.

name: Chain Lightning
description: Sends lightning arcing into every monster in sight.

name: Flame Wave
description: Sends a wave of flame rolling toward the target.

name: Doom Serpents
description: Summons serpents that hunt your enemies.

name: Blood Ritual
description: Sacrifices your own blood for power.

name: Nova
description: Blasts lightning in a ring all around you.

name: Invisibility
description: Makes you unseen by monsters.

name: Inferno
description: Breathes a short stream of fire at the target.

name: Golem
description: Summons a golem that fights at your side.

name: Rage
description: Doubles your fury for a while; the hangover costs as much again.

name: Teleport
description: Instantly moves you to the chosen spot.

name: Apocalypse
description: Rains fire on every monster in sight.

name: Etherealize
description: Makes you ethereal so physical attacks pass through you.

name: Item Repair
description: Repairs an item at the cost of some of its durability.

name: Staff Recharge
description: Restores a staff's charges at the cost of some of its maximum.

name: Trap Disarm
description: Disarms a trapped door or chest.

name: Elemental
description: Launches a fireball that seeks out the nearest monster.

name: Charged Bolt
description: Releases sparks of lightning that wander toward monsters.

name: Holy Bolt
description: Fires a holy bolt that is deadly to the undead.

name: Resurrect
description: Brings a dead ally back to life.

name: Telekinesis
description: Lets you pick up items and trigger objects from afar.

name: Heal Other
description: Restores life to another player.

name: Blood Star
description: Fires a star of blood that drains your life when mana runs out.

name: Bone Spirit
description: Sends a spirit that tears away a third of a monster's life.

name: Mana
description: Restores some mana.

name: the Magi
description: Restores all mana.

name: the Jester
description: Casts a random spell: firebolt, fireball, fire wall, guardian, chain lightning, town portal, teleport, apocalypse or stone curse.

name: Lightning Wall
description: Raises a wall of lightning.

name: Immolation
description: Hurls fireballs in every direction.

name: Warp
description: Teleports you to the nearest stairs.

name: Reflect
description: Turns part of the damage of blows back on the attacker.

name: Berserk
description: Drives a monster berserk, turning it on its own kind.

name: Ring of Fire
description: Surrounds you with a ring of fire walls.

name: Vision
description: Shows every living thing on the level and lets you see them through walls.

name: Fire Trap
description: Sets a trap that explodes in fire when stepped on.

name: Lightning Trap
description: Sets a trap that raises a wall of lightning when stepped on.

name: Nova Trap
description: Sets a trap that releases a lightning nova when stepped on.

name: Immolation Trap
description: Sets a trap that releases fireballs in every direction when stepped on.

name: Stone Trap
description: Sets a trap that turns to stone whoever steps on it.

%rec: rune
# Hellfire's placeable traps (the runes: AddRuneOf*, MI_Rune), by the IMISC_ id of the item that places them.
# spell is the SPL_ the trap goes off as, which decides its damage and what resists it; effect is what the
# player is told happens. Everything the player reads says trap, not rune.

id: IMISC_RUNEF
spell: SPL_RUNEFIRE
effect: a fire explosion

id: IMISC_RUNEL
spell: SPL_RUNELIGHT
effect: a lightning wall

id: IMISC_GR_RUNEF
spell: SPL_RUNEIMMOLAT
effect: fireballs in every direction

id: IMISC_GR_RUNEL
spell: SPL_RUNENOVA
effect: a lightning nova

id: IMISC_RUNES
spell: SPL_RUNESTONE
effect: a flash of petrification
