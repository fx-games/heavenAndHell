# glyphs.rec: how ASCII mode draws an object, by its id: a dungeon object's OBJ_ name (objects.rec), or the
# engine's own: door, door_open, sign, stash, fire, town_portal. An object with a name but no record draws as the
# first letter of its name; one without a name draws as its tile.
#   id                the object's id
#   glyph             the character drawn
#   color             "R G B"

id: door
glyph: +
color: 209 145 33

id: door_open
glyph: '
color: 209 145 33

id: sign
glyph: "
color: 209 145 33

id: stash
glyph: =
color: 220 180 60

