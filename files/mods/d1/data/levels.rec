%rec: default
# Every level of the game, one record each (LEVELS.md): towns, dungeon levels, quest and side levels alike.
#
# The fields every level has:
#   map        its id: what exits, quests and saves call it. Never parsed.
#   name       what it calls itself on arrival. \n breaks the line.
#   depth      difficulty and progress only (seeds, monster and item levels, "deepest"). Town 0; a quest or side
#              level takes its parent's.
#   generator  the algorithm that builds it: d1_cathedral, d1_catacombs, d1_caves, d1_hell (Diablo's four level
#              generators), d1_set (a quest's set piece; names its quest), accretion, megadungeon, rogue, ldtk (drawn
#              in maps.ldtk; names its template).
#   tiles      the tile set: cathedral, catacombs, caves, hell, or drawn (an ldtk level's own tiles).
#   music      a music.rec event; a level without one is silent.
#   town       true: a town (town-only spells, shopkeepers restock, the portal comes home to the deepest one).
#   start      true on the one level a new game starts on.
#   exit       "<location> -> <map id>, <arrival location>": stepping on the location takes you there. An
#              "open_when:" line after it keeps it shut until the condition (quests.rec's language) holds; an
#              "exit_tile:" line (stairs_down, stairs_up, red_portal) is what the spot turns into when it opens.
#              The generator places the locations; this file says where they lead.
#   template   (ldtk) the maps.ldtk level it is drawn as.
#   quest      (d1_set) the quests.rec key whose set piece it loads; D1's quest table gives the set level.
#
# Diablo's generators take these knobs, each defaulting to what Diablo does:
#   decoration   "name, search tile, replace tile, percent" - one single-tile decoration scattered over the
#                finished level. Repeat the field for more; naming one replaces the default list, and
#                "decoration: none" turns them off.
#   theme_freq   how often DRLG_PlaceThemeRooms seeds a theme room (0 = the strategy's own rule).
#   set_pieces   false keeps the strategy from laying out its set piece (quest rooms, Diablo's pentagram).
# The knobs accretion takes:
#   templates        the LDtk project the room templates live in. Defaults to assets/rooms.ldtk, which the mod
#                    overlay resolves to this mod's own rooms.ldtk.
#   template_prefix  only templates whose name starts with this are used - which is how a depth gets its look.
#   require_room     a template this level must contain (its quest room). Repeat the field for more.
#   forbid_room      a template this level must NOT contain, so another level's quest room cannot turn up here.
#   rooms            how many rooms to grow to (default 16).
#   min_rooms        regrow the level until it has at least this many (default 10).
#   width, height    the scratch grid the level grows into before it is trimmed (default 40x40).
#   doors            false leaves the room openings as corridors instead of placing doors.
#   wall_tile, floor_tile  the tile IDs that mean wall and floor in a template's Tiles layer (default 56, 64).
#   mirror           false keeps rooms as drawn apart from turning them; by default they may also be flipped.
#   loop_distance, loop_chance  after growing, a wall between two rooms at least loop_distance steps apart on
#                    foot opens with loop_chance, so the way back is not always the way in (defaults 10, 0.8).
#
# The knobs megadungeon takes (it carves a maze and knocks rooms into it; no level here uses it):
#   width, height            the grid it carves (default 60x60)
#   room_tries, min_room_size, room_ratio   how many rooms it tries to place, their smallest side, how far from
#                            square they may be (defaults 1266, 5, 0.25)
#   min_rooms                regrow until it has at least this many (default 10)
#   straight_passage_chance, imperfect_connect_chance   how straight the maze runs and how often a room gets a
#                            second opening (defaults 0.5)
#   door_distance            the least distance between two doors (default 5)
#   room_size_spread         a room's side is min_room_size plus 0 to room_size_spread-1 (default 5)
#   doors                    false leaves the connectors as bare openings
#   dead_ends                true keeps the maze's dead ends; by default they are filled in
#
# The knobs rogue takes (Rogue's nine rooms in a 3x3 grid, joined by passages; no level here uses it):
#   width, height    the map (default 80x24, Rogue's screen; at least 30x15)
#   max_gone_rooms   up to this many of the nine cells hold only a passage junction instead of a room (default 3)
#   extra_passages   up to this many passages beyond the ones that join every room, for loops (default 4)
#   doors            false opens passages into rooms as doorways instead of doors
# D1's levels name their stairs ladder_up and ladder_down, the town warps on 5, 9 and 13 warp, and a quest's
# entrance its quest key; the set levels name their way out ladder_up (Lazarus' lair: exit).
#   patch        "<name> = <region>": part of the level that opens later (ObjChangeMap), in the order they apply.
#                The region is "x1 y1 x2 y2" in megatiles (numbers, or the set piece's left/top/right/bottom/
#                midx/midy with +n/-n), "used OBJ_..." (each used object opens the range the generator gave it)
#                or "group OBJ_..." (once its whole lever group is used). "apply_when:" after it holds it back
#                until the condition is true; "patch_objects:" names a .DUN whose objects appear with it.

map: town
name: Tristram
depth: 0
generator: ldtk
template: Town
tiles: drawn
music: town
town: true
start: true
exit: to_cathedral -> cathedral_1, ladder_up
exit: to_catacombs -> catacombs_5, warp
open_when: deepest >= 5
exit: to_caves -> caves_9, warp
open_when: deepest >= 9
exit: to_hell -> hell_13, warp
open_when: deepest >= 13

map: cathedral_1
name: Level 1\nCathedral
depth: 1
generator: d1_cathedral
tiles: cathedral
music: cathedral
exit: ladder_up -> town, to_cathedral
exit: ladder_down -> cathedral_2, ladder_up

map: cathedral_2
name: Level 2\nCathedral
depth: 2
generator: d1_cathedral
tiles: cathedral
music: cathedral
exit: ladder_up -> cathedral_1, ladder_down
exit: ladder_down -> cathedral_3, ladder_up
exit: pwater -> dark_passage, ladder_up

map: cathedral_3
name: Level 3\nCathedral
depth: 3
generator: d1_cathedral
tiles: cathedral
music: cathedral
exit: ladder_up -> cathedral_2, ladder_down
exit: ladder_down -> cathedral_4, ladder_up
exit: leoric -> leoric_tomb, ladder_up

map: cathedral_4
name: Level 4\nCathedral
depth: 4
generator: d1_cathedral
tiles: cathedral
music: cathedral
exit: ladder_up -> cathedral_3, ladder_down
exit: ladder_down -> catacombs_5, ladder_up
patch: banner_hall = left top midx+2 midy-2
apply_when: avail("banner") and v1("banner") == 2
patch: banner_stairs = left top right+1 bottom+1
apply_when: avail("banner") and v1("banner") == 3

map: catacombs_5
name: Level 5\nCatacombs
depth: 5
generator: d1_catacombs
tiles: catacombs
music: catacombs
exit: ladder_up -> cathedral_4, ladder_down
exit: ladder_down -> catacombs_6, ladder_up
exit: warp -> town, to_catacombs
patch: blood_1 = left top+3 left+2 top+7
apply_when: avail("blood") and v2("blood") >= 1
patch: blood_2 = left+6 top+3 right top+7
apply_when: avail("blood") and v2("blood") >= 2
patch: blood_3 = left top right bottom
apply_when: avail("blood") and v2("blood") >= 3
patch_objects: l2/blood2

map: catacombs_6
name: Level 6\nCatacombs
depth: 6
generator: d1_catacombs
tiles: catacombs
music: catacombs
exit: ladder_up -> catacombs_5, ladder_down
exit: ladder_down -> catacombs_7, ladder_up
exit: schamb -> bone_chamber, ladder_up
patch: bone_chamber_book = used OBJ_BOOK2R

map: catacombs_7
name: Level 7\nCatacombs
depth: 7
generator: d1_catacombs
tiles: catacombs
music: catacombs
exit: ladder_up -> catacombs_6, ladder_down
exit: ladder_down -> catacombs_8, ladder_up
patch: blind_book = used OBJ_BLINDBOOK

map: catacombs_8
name: Level 8\nCatacombs
depth: 8
generator: d1_catacombs
tiles: catacombs
music: catacombs
exit: ladder_up -> catacombs_7, ladder_down
exit: ladder_down -> caves_9, ladder_up

map: caves_9
name: Level 9\nCaves
depth: 9
generator: d1_caves
tiles: caves
music: caves
exit: ladder_up -> catacombs_8, ladder_down
exit: ladder_down -> caves_10, ladder_up
exit: warp -> town, to_caves

map: caves_10
name: Level 10\nCaves
depth: 10
generator: d1_caves
tiles: caves
music: caves
exit: ladder_up -> caves_9, ladder_down
exit: ladder_down -> caves_11, ladder_up

map: caves_11
name: Level 11\nCaves
depth: 11
generator: d1_caves
tiles: caves
music: caves
exit: ladder_up -> caves_10, ladder_down
exit: ladder_down -> caves_12, ladder_up

map: caves_12
name: Level 12\nCaves
depth: 12
generator: d1_caves
tiles: caves
music: caves
exit: ladder_up -> caves_11, ladder_down
exit: ladder_down -> hell_13, ladder_up

map: hell_13
name: Level 13\nHell
depth: 13
generator: d1_hell
tiles: hell
music: hell
exit: ladder_up -> caves_12, ladder_down
exit: ladder_down -> hell_14, ladder_up
exit: warp -> town, to_hell
patch: steel_tome = used OBJ_STEELTOME

map: hell_14
name: Level 14\nHell
depth: 14
generator: d1_hell
tiles: hell
music: hell
exit: ladder_up -> hell_13, ladder_down
exit: ladder_down -> hell_15, ladder_up

map: hell_15
name: Level 15\nHell
depth: 15
generator: d1_hell
tiles: hell
music: hell
exit: ladder_up -> hell_14, ladder_down
exit: ladder_down -> hell_16, ladder_up
open_when: done("lazarus")
exit_tile: stairs_down
exit: lazarus -> lazarus_lair, ladder_up
open_when: v1("lazarus") >= 2 and (active("lazarus") or done("lazarus"))
exit_tile: red_portal

map: hell_16
name: Level 16\nHell
depth: 16
generator: d1_hell
tiles: hell
music: hell
exit: ladder_up -> hell_15, ladder_down
patch: skull_levers = group OBJ_SWITCHSKL

map: leoric_tomb
name: King Leoric's Tomb
depth: 3
generator: d1_set
quest: leoric
tiles: cathedral
music: cathedral
exit: ladder_up -> cathedral_3, leoric
patch: lever = used OBJ_LEVER
patch: crucified = group OBJ_CRUX1 OBJ_CRUX2 OBJ_CRUX3

map: dark_passage
name: A Dark Passage
depth: 2
generator: d1_set
quest: pwater
tiles: caves
music: caves
exit: ladder_up -> cathedral_2, pwater

map: bone_chamber
name: The Chamber of Bone
depth: 6
generator: d1_set
quest: schamb
tiles: catacombs
music: catacombs
exit: ladder_up -> catacombs_6, schamb
patch: skull_levers = group OBJ_SWITCHSKL

map: lazarus_lair
name: Lazarus' Lair
depth: 15
generator: d1_set
quest: lazarus
tiles: cathedral
music: cathedral
exit: exit -> hell_15, lazarus
open_when: done("lazarus")
exit_tile: red_portal
patch: central_circle = range OBJ_MCIRCLE2
apply_when: v1("lazarus") >= 4 or done("lazarus")
patch: way_to_lazarus = 1 11 20 18
apply_when: v1("lazarus") >= 4 or done("lazarus")
patch: helpers_rooms = 1 18 20 24
apply_when: v1("lazarus") >= 6 or done("lazarus")
patch: vile_books = used OBJ_BOOK2L