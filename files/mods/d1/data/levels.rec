patch: banner_stairs = left top right+1 bottom+1
apply_when: avail("banner") and v1("banner") == 3

map: catacombs_5
name: Level 5\nCatacombs
depth: 5
generator: megadungeon
width: 35
height: 35
room_tries: 25
min_room_size: 3
room_size_spread: 8
straight_passage_chance: 0.7
imperfect_connect_chance: 0.6
room_ratio: 0.6
door_distance: 4
min_rooms: 8
inner_room_chance: 0
posts: 0.03
door_chance: 0.5
theme_rooms: 6 10 0
theme_room_doors: true
canvas: 40
scale: 2
population: d1_catacombs
decoration: tile.catacombs_wall_see_through 1
set_piece: piece_l2_blood room blood
tiles: catacombs
music: catacombs
exit: ladder_up -> cathedral_4, ladder_down
exit: ladder_down -> catacombs_6, ladder_up
exit: warp -> town, to_catacombs
patch: blood_1 = left top+3 left+2 top+7
apply_when: avail("blood") and v2("blood") >= 1
patch: blood_2 = left+6 top+3 right top+7
apply_when: avail("blood") and v2("blood") >= 2
patch: blood_3 = left top right bottom
apply_when: avail("blood") and v2("blood") >= 3
patch_objects: l2/blood2

