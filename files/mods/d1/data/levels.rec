%rec: default
# Every level of the game, one record each (LEVELS.md): towns, dungeon levels, quest and side levels alike.
#
# The fields every level has:
#   map        its id: what exits, quests and saves call it. Never parsed.
#   name       what it calls itself on arrival. \n breaks the line.
#   depth      difficulty and progress only (seeds, monster and item levels, "deepest"). Town 0; a quest or side
#              level takes its parent's.
#   generator  the algorithm that builds it: d1_cathedral, d1_catacombs, d1_caves, d1_hell (Diablo's four level
#              generators), d1_set (a quest's set piece; names its quest), accretion, megadungeon, rogue, drawn (hand-drawn
#              in the mod's maps; names its template).
#   tiles      the tile set: cathedral, catacombs, caves, hell, or drawn (a hand-drawn level's own tiles).
#   music      a music.rec event; a level without one is silent.
#   glyphs     an 8x8 glyph atlas in the mod folder (Bm437_IBM_CGA.png): the level is drawn as text with it.
#   town       true: a town (town-only spells, shopkeepers restock, the portal comes home to the deepest one).
#   start      true on the one level a new game starts on.
#   monster    "<internal_name>": for a side level that shares its depth with a regular one: it rolls only these,
#              random_spawn: false or not. Repeatable. Every other level rolls the enemies.rec records whose
#              dlvl..max_dlvl takes in its depth. Either way D1's rules pick the types (spawn_cost against a budget
#              of 4000) and the count (a monster per 30 floor cells, in groups). Dungen levels only.
#   exit       "<location> -> <map id>, <arrival location>": stepping on the location takes you there. An
#              "open_when:" line after it keeps it shut until the condition (quests.rec's language) holds; an
#              "exit_tile:" line (stairs_down, stairs_up, red_portal) is what the spot turns into when it opens.
#              The generator places the locations; this file says where they lead.
#   location   "<name> <x> <y>": a named map cell the level's quest logic or an exit refers to (Lazarus'
#              lair: vile_book_N / vile_book_N_to, vile_center, vile_altar, exit). Repeatable.
#   template   (drawn) the map file it is drawn as.
#   quest      (d1_set) the quests.rec key whose set piece it loads.
#
# The knobs accretion takes:
#   templates        the maps directory the room templates live in. Defaults to assets/maps, which the mod
#                    overlay resolves to this mod's own maps.
#   template_prefix  only templates whose name starts with this are used - which is how a depth gets its look.
#   require_room     a template this level must contain (its quest room). Repeat the field for more. No other
#                    level grows a room some level requires.
#   rooms            how many rooms to grow to (default 16).
#   min_rooms        regrow the level until it has at least this many (default 10).
#   width, height    the scratch grid the level grows into before it is trimmed (default 40x40).
#   doors            false leaves the room openings as corridors instead of placing doors.
#   wall_tile, floor_tile  the tile IDs that mean wall and floor in a template's Tiles layer (default 56, 64).
#   mirror           false keeps rooms as drawn apart from turning them; by default they may also be flipped.
#   loop_distance, loop_chance  after growing, a wall between two rooms at least loop_distance steps apart on
#                    foot opens with loop_chance, so the way back is not always the way in (defaults 20, 1:
#                    Brogue's). A doorway, loop or not, gets a door 60% of the time and stays open otherwise.
#   lakes            how many lakes of deep water to try to lay over the grown level, each ringed with shallows
#                    and never cutting the level in two (Brogue's; default 0).
#
# The knobs megadungeon takes (it carves a maze and knocks rooms into it; no level here uses it):
#   width, height            the grid it carves (default 60x60)
#   room_tries, min_room_size, room_ratio   how many rooms it tries to place, their smallest side, how far from
#                            square they may be (defaults 1266, 5, 0.25)
#   min_rooms                regrow until it has at least this many (default 10)
#   straight_passage_chance, imperfect_connect_chance   how straight the maze runs and how often a room gets a
#                            second opening (defaults 0.5)
#   door_distance            the least distance between two doors (default 5)
#   room_size_spread         a room's side is min_room_size plus 0 to room_size_spread-1 (default 5)
#   doors                    false leaves the connectors as bare openings
#   dead_ends                true keeps the maze's dead ends; by default they are filled in
#   inner_room_chance        chance a room of 7x7 or more gets a room walled inside it, one doorway in (default 0)
#
# The knobs rogue takes (Rogue's nine rooms in a 3x3 grid, joined by passages; no level here uses it):
#   width, height    the map (default 80x24, Rogue's screen; at least 30x15)
#   max_gone_rooms   up to this many of the nine cells hold only a passage junction instead of a room (default 3)
#   extra_passages   up to this many passages beyond the ones that join every room, for loops (default 4)
#   doors            false opens passages into rooms as doorways instead of doors
# D1's levels name their stairs ladder_up and ladder_down, the town warps on 5, 9 and 13 warp, and a quest's
# entrance its quest key; the set levels name their way out ladder_up (Lazarus' lair: exit).
#   patch        "<name> = <region>": part of the level that opens later (ObjChangeMap), in the order they apply.
#                The region is "x1 y1 x2 y2" in megatiles (numbers, or the set piece's left/top/right/bottom/
#                midx/midy with +n/-n), "used OBJ_..." (each used object opens the range the generator gave it)
#                or "group OBJ_..." (once its whole lever group is used). "apply_when:" after it holds it back
#                until the condition is true; "patch_objects:" names a .DUN whose objects appear with it.

map: town
name: Tristram
depth: 0
generator: drawn
template: Town
tiles: drawn
music: town
town: true
start: true
exit: to_cathedral -> cathedral_1, ladder_up
exit: to_catacombs -> catacombs_5, warp
open_when: deepest >= 5
exit: to_caves -> caves_9, warp
open_when: deepest >= 9
exit: to_hell -> hell_13, warp
open_when: deepest >= 13

map: cathedral_1
name: Level 1\nCathedral
depth: 1
generator: bsp
width: 40
height: 40
min_leaf: 6
min_room: 2
grow: 4
hall_chance: 0.15
spine: true
arch_chance: 0.12
loop_chance: 0.6
loop_distance: 8
posts: 0.02
door_chance: 0.55
canvas: 40
scale: 2
population: d1_cathedral
decoration: tile.arch 3.3
decoration: tile.grate 2.1
decoration: tile.cathedral_wall_missiles_pass 2
decoration: tile.cathedral_wall_see_through 1.5
tiles: cathedral
music: cathedral
exit: ladder_up -> town, to_cathedral
exit: ladder_down -> cathedral_2, ladder_up

