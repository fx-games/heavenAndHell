%rec: weapon_bonus
# Melee damage by weapon type against a monster class (PlrHitMonst): swords cut flesh, maces crush bone. The
# first weapon named here that the hero holds is the one judged, so a sword in either hand wins over a mace.

weapon: sword
versus: MC_ANIMAL
percent: 50

weapon: sword
versus: MC_UNDEAD
percent: -50

weapon: mace
versus: MC_UNDEAD
percent: 50

weapon: mace
versus: MC_ANIMAL
percent: -50
